// Writes msg into buf. Returns the number of bytes written, or 0 if buf is too small.
template <typename T>
inline std::size_t serialize(const T& msg, std::byte* buf, std::size_t buf_len) noexcept {
    static_assert(std::is_trivially_copyable_v<T>);
    if (buf_len < sizeof(T)) {
        return 0;
    }
    std::memcpy(buf, &msg, sizeof(T));
    return sizeof(T);
}
