#include <cstdint>

{% for schema in schemas %}
struct {{ schema.name }} {
    {% for field in schema.fields %}
    {{ field.type.cpp }} {{ field.name }};
    {% endfor %}
};

template <typename T>
inline void serialize(const T& msg, std::byte* buf) {
    static_assert(std::is_trivially_copyable_v<T>);
    std::memcpy(buf, &msg, sizeof(T));
}

{% endfor %}
